# Moso AI Configuration Template
# Copy this file to .env and adjust as necessary

# ------------------------------------------------------------------------------
# Ollama Engine Configuration
# ------------------------------------------------------------------------------
# Base URL for the local Ollama daemon (must be running locally or in your private LAN)
OLLAMA_HOST=http://localhost:11434

# Default model: qwen3.5:4b (or qwen3.5:2b for ultra-lightweight setups)
# MOSO_DEFAULT_MODEL=qwen3.5:4b
# Make sure to run `ollama pull qwen3.5:4b`

# ------------------------------------------------------------------------------
# Web Search & Retrieval Configuration (Optional)
# ------------------------------------------------------------------------------
# By default, Moso AI operates in 100% free mode using DuckDuckGo + Wikipedia
# without requiring any API keys or account registration.

# (Optional) Ollama-hosted or custom search API endpoint
# OLLAMA_SEARCH_ENDPOINT=https://api.ollama.com/v1/search
# OLLAMA_API_KEY=your_ollama_api_key_here

# (Optional) Tavily Search API key (for specialized research queries)
# TAVILY_API_KEY=tvly-your-tavily-api-key-here

# ------------------------------------------------------------------------------
# Remote / Public Forwarding Security (Optional)
# ------------------------------------------------------------------------------
# If sharing the Vite frontend port via VS Code Port Forwarding or a tunnel,
# set a non-empty password to protect all chat, document upload, and tool routes.
# Leave empty for unauthenticated single-user local development.
MOSO_ACCESS_PASSWORD=
